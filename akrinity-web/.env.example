# Copy to .env.local for local development. Never commit real values.

# Public: WooCommerce / WPGraphQL endpoints (safe to expose to the browser)
NEXT_PUBLIC_WP_GRAPHQL_URL=https://cms.example.com/graphql
NEXT_PUBLIC_WC_STORE_API_URL=https://cms.example.com/wp-json/wc/store/v1
NEXT_PUBLIC_SITE_URL=https://akrinity.example.com

# Public: analytics and bot protection site keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=

# Server only (set in Cloudflare Pages / Workers environment, not here):
# WC_CONSUMER_KEY=
# WC_CONSUMER_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# TURNSTILE_SECRET_KEY=
# REVALIDATE_SECRET=
