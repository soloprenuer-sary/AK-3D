# Copy to .env.local for development. In production these are set in the Vercel project (Settings > Environment Variables). Never commit real values.

# Public: WooCommerce and WPGraphQL endpoints (safe to expose to the browser)
NEXT_PUBLIC_WP_GRAPHQL_URL=https://admin.akrinity.in/graphql
NEXT_PUBLIC_WC_STORE_API_URL=https://admin.akrinity.in/wp-json/wc/store/v1
NEXT_PUBLIC_SITE_URL=https://akrinity.example.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=

# Server only (mark as Sensitive in Vercel)
WP_URL=https://admin.akrinity.in
# Private key shared with WordPress: the same value goes in wp-config.php as AKRINITY_SHARED_SECRET (40+ characters)
AKRINITY_SHARED_SECRET=
# Optional: shared rate-limit counters (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# TURNSTILE_SECRET_KEY=
# Only while checking setup: open /api/auth/status
# AUTH_STATUS=1
# Only when the site is opened from another origin in development
# ALLOWED_ORIGINS=http://localhost:3000
