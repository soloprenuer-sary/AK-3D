{
  "name": "akrinity-web",
  "version": "0.1.0",
  "private": true,
  "description": "Akrinity headless storefront (Next.js, React, GSAP, three.js) for a WooCommerce backend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "pages:dev": "wrangler pages dev out",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "graphql": "^16.15.0",
    "graphql-request": "^7.4.0",
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.29",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.0",
    "serve": "^14.2.7",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.160.1"
  }
}
