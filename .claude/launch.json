{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "akrinity-web-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--prefix", "akrinity-web", "serve", "akrinity-web/out", "-l", "3000"],
      "port": 3000
    },
    {
      "name": "akrinity-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "akrinity-web", "run", "dev", "--", "-p", "3100"],
      "port": 3100
    }
  ]
}
